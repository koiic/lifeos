                  "route": {
                    "maxLength": 200,
                    "pattern": "^(/|(/([a-z-]+|:[a-zA-Z]+|\\*))+/?)$",
                    "title": "Route",
                    "type": "string"
                  },
                  "version": {
                    "maxLength": 50,
                    "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$",
                    "title": "Version",
                    "type": "string"
                  }
