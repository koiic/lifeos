          "provisioning_uri": {
            "title": "Provisioning Uri",
            "type": "string"
          }
        },
        "required": [
          "provisioning_uri"
        ],
        "title": "PasswordRegistered",
        "type": "object"
      },
      "PasswordRegistration": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 254,
            "title": "Email",
            "type": "string"
          },
          "name": {
            "maxLength": 400,
            "title": "Name",
            "type": "string"
          },
          "password": {
            "maxLength": 256,
            "title": "Password",
            "type": "string"
          },
          "token": {
            "maxLength": 200,
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token",
          "name",
          "email",
          "password"
        ],
        "title": "PasswordRegistration",
        "type": "object"
      },
      "PasswordSignIn": {
        "additionalProperties": false,
