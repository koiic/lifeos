{
  "name": "lifeos-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:unit": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && stylelint \"src/**/*.css\" --max-warnings 0",
    "format": "prettier --write .",
    "build": "vite build",
    "dev": "vite",
    "size": "size-limit",
    "ladle": "ladle serve",
    "ladle:build": "ladle build",
    "test:e2e": "ladle build && vite build && playwright test",
    "lighthouse": "vite build && CHROME_PATH=$(node -e \"console.log(require('playwright').chromium.executablePath())\") lhci autorun"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@simplewebauthn/browser": "14.0.0",
    "@tanstack/react-query": "5.104.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "idb": "8.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.89.0",
    "react-router-dom": "6.30.6",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-window": "7.4.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "9.39.5",
    "@ladle/react": "5.1.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.0",
    "@size-limit/file": "14.1.0",
    "@testing-library/react": "15.0.7",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "size-limit": "14.1.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3",
    "workbox-build": "7.4.1"
  }
}
