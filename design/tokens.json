{
  "$schema_note": "Life OS design tokens v1. Source: spec section 5.3-5.6. The ONLY place design values are defined. Read-only for Claude Code; change via change request. Generate CSS/TS with scripts/build_tokens.py.",
  "version": 1,
  "themes": {
    "light": {
      "name": "Sorbet",
      "color": {
        "bg": "#FFF4F1",
        "surface": "#FFFFFF",
        "surface-tint": "#FFD9CF",
        "ink": "#2B1B2E",
        "ink-muted": "#6E5468",
        "accent": "#FF6B5A",
        "accent-ink": "#2B1B2E",
        "fertile": "#9EE6C8",
        "sun": "#FFC94D",
        "lilac": "#D9CCFF",
        "butter": "#FFE08A",
        "danger": "#B3261E",
        "border-strong": "#2B1B2E"
      },
      "font": {
        "display": "'Bricolage Grotesque', system-ui, sans-serif",
        "body": "'DM Sans', system-ui, sans-serif"
      },
      "font-weight": {
        "display": "800",
        "heading": "800"
      }
    },
    "dark": {
      "name": "Night Garden",
      "color": {
        "bg": "#14122B",
        "surface": "#221F45",
        "surface-tint": "#2E2A57",
        "ink": "#F3EEFF",
        "ink-muted": "#B7AFD9",
        "accent": "#FFB4A2",
        "accent-ink": "#14122B",
        "fertile": "#7DE3C8",
        "sun": "#FFD97A",
        "lilac": "#9D8CFF",
        "butter": "#4A4578",
        "danger": "#FF8A80",
        "border-strong": "#7A72B4"
      },
      "font": {
        "display": "'Fraunces', Georgia, serif",
        "body": "'DM Sans', system-ui, sans-serif"
      },
      "font-weight": {
        "display": "600",
        "heading": "600"
      }
    }
  },
  "shared": {
    "font-size": {
      "display": "2.25rem",
      "h1": "2.125rem",
      "h2": "1.25rem",
      "body": "1rem",
      "label": "0.875rem",
      "caption": "0.8125rem",
      "numeral": "4rem"
    },
    "line-height": {
      "tight": "1.05",
      "heading": "1.15",
      "body": "1.45"
    },
    "space": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px"
    },
    "radius": {
      "chip": "999px",
      "button": "20px",
      "card": "24px",
      "card-lg": "32px",
      "sheet": "32px",
      "input": "16px"
    },
    "shadow": {
      "none": "none",
      "sticker": "3px 3px 0 var(--border-strong)"
    },
    "motion": {
      "duration-fast": "150ms",
      "duration-base": "250ms",
      "duration-ring": "600ms",
      "ease-out": "cubic-bezier(0.22, 1, 0.36, 1)",
      "ease-bounce": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    },
    "size": {
      "touch-target": "44px",
      "nav-height": "72px",
      "focus-ring": "2px"
    }
  },
  "contrast_pairs": [
    {
      "fg": "ink",
      "bg": "bg",
      "min": 4.5,
      "use": "Body text on page"
    },
    {
      "fg": "ink",
      "bg": "surface",
      "min": 4.5,
      "use": "Body text on cards"
    },
    {
      "fg": "ink",
      "bg": "surface-tint",
      "min": 4.5,
      "use": "Text on tinted areas"
    },
    {
      "fg": "ink-muted",
      "bg": "bg",
      "min": 4.5,
      "use": "Secondary text on page"
    },
    {
      "fg": "ink-muted",
      "bg": "surface",
      "min": 4.5,
      "use": "Secondary text on cards"
    },
    {
      "fg": "accent-ink",
      "bg": "accent",
      "min": 4.5,
      "use": "Text on cycle card and primary buttons"
    },
    {
      "fg": "accent-ink",
      "bg": "fertile",
      "min": 4.5,
      "use": "Text on fertile chips and mood tiles"
    },
    {
      "fg": "accent-ink",
      "bg": "sun",
      "min": 4.5,
      "use": "Text on add button and streak badge"
    },
    {
      "fg": "accent-ink",
      "bg": "lilac",
      "min": 4.5,
      "use": "Text on appointment tiles and selected chips"
    },
    {
      "fg": "ink",
      "bg": "butter",
      "min": 4.5,
      "use": "Text on medication tiles"
    },
    {
      "fg": "danger",
      "bg": "bg",
      "min": 4.5,
      "use": "Error text on page"
    },
    {
      "fg": "danger",
      "bg": "surface",
      "min": 4.5,
      "use": "Error text on cards"
    },
    {
      "fg": "border-strong",
      "bg": "surface",
      "min": 3.0,
      "use": "Sticker outlines and chip borders (non-text)"
    },
    {
      "fg": "border-strong",
      "bg": "bg",
      "min": 3.0,
      "use": "Outlines on page (non-text)"
    },
    {
      "fg": "border-strong",
      "bg": "surface-tint",
      "min": 3.0,
      "use": "Outlines on tinted areas (non-text)"
    }
  ]
}
